NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_MAP_DEMO_STORAGE=true

# Kakao Developers > App > Platform key > JavaScript key
# Register http://localhost:3300 as a JavaScript SDK domain for local demos.
# Do not commit a real key here.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here
